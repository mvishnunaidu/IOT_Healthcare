# ==============================================================================
# HealthGuard IoT - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the Python backend or React frontend.

# Server & API Configuration
APP_NAME=HealthGuard_IoT
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080

# Security & Authentication (Change in production)
SECRET_KEY=healthguard_super_secret_jwt_key_for_development_only_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite Database URL
DATABASE_URL=sqlite:///./healthcare_iot.db

# Edge Processing & IoT Gateway Settings
EDGE_EMA_ALPHA=0.3
EDGE_LATENCY_MS_MIN=8
EDGE_LATENCY_MS_MAX=25
EDGE_SIGNAL_QUALITY_BASE=98.5

# Simulation Engine Settings
SIMULATOR_DEFAULT_INTERVAL_SEC=3.0
SIMULATOR_MODE=NORMAL
SIMULATOR_NOISE_AMPLITUDE=0.8

# Optional Firebase / Cloud Integration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
